# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler
SUPABASE_DB_SESSION_POOL_URL="postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require"

# Optional. Keep this small for the website form.
SUPABASE_DB_POOL_MAX=5

# Optional for local development if Node reports SELF_SIGNED_CERT_IN_CHAIN.
# The connection is still encrypted, but certificate chain verification is skipped.
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=false
